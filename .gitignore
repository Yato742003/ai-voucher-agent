# Environment & secrets (keep .env.example templates)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Real business accounting data & uploaded scans (local only)
ketoan-db/
ketoan-backend/uploads/*
!ketoan-backend/uploads/.gitkeep
ketoan-backend/uploads/signed_scans/*

# Python virtualenvs, caches & local artifacts
.venv/
venv/
**/venv/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
*.egg-info/

# Frontend dependencies & build output
**/node_modules/
ketoan-frontend/dist/

# Crash dumps, logs, local DB files & OS noise
*.stackdump
**/*.stackdump
*.log
*.db
*.sqlite*
.DS_Store
Thumbs.db
