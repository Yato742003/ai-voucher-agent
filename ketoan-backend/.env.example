# Copy file này thành ".env" rồi điền giá trị thật — KHÔNG commit file .env thật lên Git.

# --- Dùng khi chạy docker-compose ---
POSTGRES_PASSWORD=doi_mat_khau_nay
SECRET_KEY=doi_thanh_chuoi_ngau_nhien_dai_it_nhat_32_ky_tu
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=doi_mat_khau_admin_dau_tien

# --- Dùng khi chạy trực tiếp (không qua docker-compose), ví dụ lúc code/test ---
# Nếu không đặt DATABASE_URL, app sẽ tự ghép từ POSTGRES_PASSWORD + mặc định:
# postgresql+psycopg2://ketoan:<POSTGRES_PASSWORD>@127.0.0.1:5432/ketoan_db
# DATABASE_URL=postgresql+psycopg2://ketoan:doi_mat_khau_nay@127.0.0.1:5432/ketoan_db

# --- Tính năng scan bảng kê -> phiếu chi ---
# Chọn provider: "claude" (mặc định) hoặc "nim"
SCAN_PROVIDER=claude

# Provider Claude (Anthropic) — dùng khi SCAN_PROVIDER=claude
ANTHROPIC_API_KEY=sk-ant-...
SCAN_EXTRACTION_MODEL=claude-sonnet-4-6

# Provider NVIDIA NIM — dùng khi SCAN_PROVIDER=nim
# Lấy key miễn phí tại: https://build.nvidia.com
NIM_API_KEY=nvapi-...
NIM_EXTRACTION_MODEL=meta/llama-3.2-90b-vision-instruct
